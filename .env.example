VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/v1
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# No API token here: nginx (Docker) and the Vite dev server attach the backend's bearer upstream.
# The dev server's token path, LEITSTAND_AUTH_TOKEN_FILE, is a shell variable, not a key here.

# Production container (read by docker compose and nginx, not Vite).
# BACKEND_URL is a bare origin: a path or trailing slash makes proxy_pass strip the /api/ prefix.
# BACKEND_URL=http://backend:8080
# FRONTEND_HOST_PORT=80
# FRONTEND_BIND_ADDR=0.0.0.0
# LEITSTAND_SECRETS_DIR=../leitstand-backend/secrets
