VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/v1
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Production docker-compose runtime overrides (read by nginx, not Vite).
# BACKEND_URL must be a bare origin: scheme + host + port only.
# No path, no trailing slash -- either turns the proxy_pass into a
# URI-form one and strips the /api/ prefix from the upstream call.
# BACKEND_URL=http://host.docker.internal:8080
# FRONTEND_HOST_PORT=80
