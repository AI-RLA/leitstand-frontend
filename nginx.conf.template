server {
  listen 80;
  server_name _;
  server_tokens off;

  # Resolve the upstream per request (Docker's embedded DNS), so start order does not matter.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend ${BACKEND_URL};

  # The bearer this proxy attaches applies to every request, like a cookie without SameSite: a page
  # from another origin open in the operator's browser could use it. Browsers send Origin on every
  # cross-origin POST and every WebSocket handshake, so a foreign one is refused before proxying.
  set $foreign_origin 0;
  if ($http_origin) {
    set $foreign_origin 1;
  }
  if ($http_origin = "$scheme://$http_host") {
    set $foreign_origin 0;
  }

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/javascript
    application/json
    application/wasm
    application/xml
    image/svg+xml
    text/css
    text/plain;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # Chat is the one server-sent-event stream under /api/, and the
  # defaults are wrong for it in two ways: buffering holds tokens
  # back until a buffer fills, so an answer that streams over
  # seconds arrives all at once and reads as a hang, and the 60s
  # read timeout would cut a slow turn mid-answer. An exact-match
  # location wins over the /api/ prefix below, so only this route
  # is affected. Neither shows up in dev, where Vite proxies
  # straight through.
  location = /api/v1/chat {
    if ($foreign_origin) {
      return 403;
    }
    # Every turn posts the whole conversation, tool results included.
    client_max_body_size 16m;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    include /etc/nginx/conf.d/auth.inc;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
  }

  # proxy_pass has NO trailing slash on purpose: with one, nginx
  # would strip the /api/ location prefix from the upstream URI.
  # auth.inc, rendered at start from the mounted secret, attaches the bearer the browser never holds.
  location /api/ {
    if ($foreign_origin) {
      return 403;
    }
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    include /etc/nginx/conf.d/auth.inc;
  }

  location /ws/ {
    if ($foreign_origin) {
      return 403;
    }
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    include /etc/nginx/conf.d/auth.inc;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # nginx replaces (does not merge) inherited add_header lists once
  # any add_header is set in the inner scope, so the server-level
  # security headers are repeated below where Cache-Control is set.
  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
